# --- DEPENDENCIES ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- NEXT.JS & VERCEL ---
/.next/
/out/
/build
.vercel

# --- DATABASE & INFRASTRUCTURE (CRITICAL) ---
# Ignore the local PostgreSQL storage folder we created in docker-compose
# If you don't ignore this, you will push GBs of binary data to GitHub
postgres_data/

# If you have any local Nginx or Redis logs
*.log
docker-compose.override.yml

# --- ENVIRONMENT VARIABLES (SECURITY) ---
# We ignore all local env files to prevent leaking secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# DO NOT ignore .env.example if you create one later (it's safe)

# --- PRISMA ---
# Generated client should be built on the server/container, not committed
/lib/generated/prisma
node_modules/.prisma

# --- TYPESCRIPT ---
*.tsbuildinfo
next-env.d.ts

# --- TESTING ---
/coverage

# --- MISC / OS METADATA ---
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*